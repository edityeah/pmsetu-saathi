PORT=8787
JWT_SECRET=pmsetu-dev-secret-change-me
# Protects /api/admin/* (seed + status). Any long random string.
ADMIN_TOKEN=pmsetu-admin-dev-token
# Local: SQLite. Hosted: a postgres:// URL (Render injects it); the Postgres schema is derived automatically.
DATABASE_URL="file:./data/pmsetu.db"
# OpenAI powers Saathi chat, intent routing, OCR and voice. Leave blank to run the UI without AI.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=verse
RATE_LIMIT_PER_HOUR=200
ALLOWED_ORIGIN=http://localhost:5173
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ZEP_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-2
